# Normalize line endings: store text as LF in the repository on every platform.
* text=auto eol=lf

# Explicit text types (source, docs, metadata, build).
*.h        text eol=lf
*.hpp      text eol=lf
*.c        text eol=lf
*.cpp      text eol=lf
*.ino      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.cmake    text eol=lf
*.properties text eol=lf
CMakeLists.txt text eol=lf

# Common binary types (never normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
